{
  "schema_version": 1,
  "timeout_frames": 120,
  "actions": [
    {"action": "wait", "frames": 5},
    {"action": "expect_editor", "expect": "simulation", "text": "running"},
    {"action": "capture", "target": {"text": "PLAY", "origin": "editor"}, "padding": 10},
    {"action": "click", "target": {"text": "PAUSE", "origin": "editor"}},
    {"action": "expect_editor", "expect": "simulation", "text": "paused"},
    {"action": "capture", "target": {"text": "PAUSE", "origin": "editor"}, "padding": 10}
  ]
}
