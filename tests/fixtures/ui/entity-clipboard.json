{
  "schema_version": 1,
  "timeout_frames": 180,
  "actions": [
    {"action": "key", "key": "stop"},
    {"action": "click", "target": {"text": "Left Cube", "origin": "editor"}},
    {"action": "click", "target": {"text": "Right Cube", "origin": "editor"}, "shift": true},
    {"action": "key", "key": "copy_entities"},
    {"action": "key", "key": "paste_entities"},
    {"action": "expect", "target": {"text": "Left Cube Copy", "origin": "editor"}, "expect": "visible"},
    {"action": "expect", "target": {"text": "Right Cube Copy", "origin": "editor"}, "expect": "visible"},
    {"action": "key", "key": "cut_entities"},
    {"action": "key", "key": "undo"},
    {"action": "expect", "target": {"text": "Left Cube Copy", "origin": "editor"}, "expect": "visible"},
    {"action": "expect", "target": {"text": "Right Cube Copy", "origin": "editor"}, "expect": "visible"},
    {"action": "capture", "target": {"name": "__scrapbot_editor_scene", "origin": "editor"}, "padding": 8}
  ]
}
