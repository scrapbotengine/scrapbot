{
  "schema_version": 1,
  "timeout_frames": 180,
  "actions": [
    {"action": "expect_editor", "expect": "simulation", "text": "running"},
    {"action": "expect_editor", "expect": "dirty", "text": "false"},
    {"action": "click", "target": {"text": "Left Cube", "origin": "editor"}},
    {"action": "wait", "frames": 2},
    {"action": "type", "target": {"component": "scrappyphysics.rigidbody", "field": "velocity", "axis": "x", "origin": "editor"}, "text": "4.5"},
    {"action": "key", "key": "enter"},
    {"action": "wait", "frames": 2},
    {"action": "expect", "target": {"component": "scrappyphysics.rigidbody", "field": "velocity", "axis": "x", "origin": "editor"}, "expect": "text", "text": "4.50"},
    {"action": "expect_editor", "expect": "staged_play_changes", "text": "1"},
    {"action": "expect_editor", "expect": "dirty", "text": "false"},
    {"action": "key", "key": "stop"},
    {"action": "wait", "frames": 4},
    {"action": "expect_editor", "expect": "simulation", "text": "stopped"},
    {"action": "expect_editor", "expect": "staged_play_changes", "text": "0"},
    {"action": "expect_editor", "expect": "dirty", "text": "true"},
    {"action": "expect_editor", "expect": "history_cursor", "text": "1"},
    {"action": "expect_editor", "expect": "history_count", "text": "1"},
    {"action": "expect", "target": {"component": "scrappyphysics.rigidbody", "field": "velocity", "axis": "x", "origin": "editor"}, "expect": "text", "text": "4.50"},
    {"action": "key", "key": "undo"},
    {"action": "wait", "frames": 2},
    {"action": "expect_editor", "expect": "dirty", "text": "false"},
    {"action": "expect_editor", "expect": "history_cursor", "text": "0"},
    {"action": "expect", "target": {"component": "scrappyphysics.rigidbody", "field": "velocity", "axis": "x", "origin": "editor"}, "expect": "text", "text": "0.00"},
    {"action": "key", "key": "redo"},
    {"action": "wait", "frames": 2},
    {"action": "expect_editor", "expect": "dirty", "text": "true"},
    {"action": "expect_editor", "expect": "history_cursor", "text": "1"},
    {"action": "expect", "target": {"component": "scrappyphysics.rigidbody", "field": "velocity", "axis": "x", "origin": "editor"}, "expect": "text", "text": "4.50"},
    {"action": "capture", "target": {"component": "scrappyphysics.rigidbody", "origin": "editor"}, "padding": 8}
  ]
}
