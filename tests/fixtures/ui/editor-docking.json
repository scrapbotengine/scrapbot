{
  "schema_version": 1,
  "timeout_frames": 120,
  "actions": [
    {
      "action": "drag",
      "target": {"name": "__scrapbot_editor_left_dock_item", "origin": "editor", "part": "dock_tab"},
      "destination": {"name": "__scrapbot_editor_right_dock_item", "origin": "editor", "part": "dock_tab"},
      "destination_anchor": "center",
      "frames": 4
    },
    {"action": "wait", "frames": 2},
    {"action": "expect", "target": {"name": "__scrapbot_editor_left_dock_item", "origin": "editor"}, "expect": "visible"},
    {"action": "capture", "target": {"name": "__scrapbot_editor_right", "origin": "editor"}, "padding": 8}
  ]
}
