{
  "schema_version": 1,
  "timeout_frames": 180,
  "actions": [
    {"action": "click", "target": {"text": "STOP", "origin": "editor"}},
    {"action": "wait", "frames": 2},
    {"action": "click", "target": {"name": "__scrapbot_editor_resource_dock_item", "origin": "editor", "part": "dock_tab"}},
    {"action": "expect", "target": {"name": "__scrapbot_editor_placement_snap", "origin": "editor"}, "expect": "text", "text": "SNAP 0.5"},
    {"action": "click", "target": {"name": "__scrapbot_editor_placement_snap", "origin": "editor"}},
    {"action": "expect", "target": {"name": "__scrapbot_editor_placement_snap", "origin": "editor"}, "expect": "text", "text": "SNAP 1"},
    {"action": "drag", "target": {"text": "Triangle Model", "origin": "editor", "occurrence": 0}, "destination": {"name": "__scrapbot_editor_viewport", "origin": "editor"}, "frames": 4},
    {"action": "wait", "frames": 3},
    {"action": "expect", "target": {"name": "__scrapbot_editor_inspector_entity_name", "origin": "editor"}, "expect": "text", "text": "Triangle Model"},
    {"action": "expect", "target": {"name": "__scrapbot_editor_status_text", "origin": "editor"}, "expect": "text", "text": "STOPPED  /  UNSAVED"},
    {"action": "click", "target": {"text": "UNDO", "origin": "editor"}},
    {"action": "wait", "frames": 2},
    {"action": "expect", "target": {"name": "__scrapbot_editor_status_text", "origin": "editor"}, "expect": "text", "text": "STOPPED"},
    {"action": "click", "target": {"text": "REDO", "origin": "editor"}},
    {"action": "wait", "frames": 2},
    {"action": "expect", "target": {"name": "__scrapbot_editor_status_text", "origin": "editor"}, "expect": "text", "text": "STOPPED  /  UNSAVED"},
    {"action": "capture", "target": {"name": "__scrapbot_editor_right", "origin": "editor"}, "padding": 8}
  ]
}
