{
  "schema_version": 1,
  "timeout_frames": 120,
  "actions": [
    {"action": "wait", "frames": 10},
    {"action": "expect", "target": {"text": "SYSTEMS / 21", "origin": "editor"}, "expect": "visible"},
    {"action": "type", "target": {"name": "__scrapbot_editor_systems_filter", "origin": "editor"}, "text": "submit"},
    {"action": "expect", "target": {"name": "__scrapbot_editor_systems_filter", "origin": "editor"}, "expect": "text", "text": "submit"},
    {"action": "expect", "target": {"text": "scrapbot.render.submit", "origin": "editor"}, "expect": "visible"},
    {"action": "capture", "target": {"name": "__scrapbot_editor_systems", "origin": "editor"}, "padding": 4}
  ]
}
